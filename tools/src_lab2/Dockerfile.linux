FROM gcc:14
RUN apt-get update && apt-get install -y --no-install-recommends gdb xvfb xauth dbus-x11 \
      libnss3 libgtk-3-0 libxkbfile1 libsecret-1-0 libgbm1 libasound2t64 libxss1 libatk-bridge2.0-0 \
      fonts-dejavu-core fonts-ubuntu fonts-noto-mono curl ca-certificates \
    || apt-get install -y --no-install-recommends gdb xvfb xauth dbus-x11 libnss3 libgtk-3-0 libxkbfile1 \
      libsecret-1-0 libgbm1 libasound2 libxss1 libatk-bridge2.0-0 fonts-dejavu-core curl ca-certificates
RUN curl -fsSL -o /tmp/code.deb "https://update.code.visualstudio.com/latest/linux-deb-arm64/stable" \
    && apt-get install -y /tmp/code.deb && rm /tmp/code.deb && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /bin/bash user
USER user
WORKDIR /home/user
